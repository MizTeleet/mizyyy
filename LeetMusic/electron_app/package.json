{
  "name": "leetmusic-desktop",
  "version": "1.0.0",
  "description": "LeetMusic desktop app on Electron",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "npm run build:win",
    "build:win": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.leetmusic.desktop",
    "productName": "LeetMusic",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "Music/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "LeetMusic.exe"
    }
  },
  "devDependencies": {
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3"
  }
}
